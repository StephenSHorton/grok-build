#!/usr/bin/env bash
# grok-fork launcher. Does not overwrite official `grok`.
#
# Install this on PATH as `grok-fork` (Windows: grok-fork.cmd → grok-fork.ps1).
# Fork updates are git fetch + rebase onto xai-org/grok-build + cargo rebuild.
# That path cannot be skipped. Any failure exits 1 and does not exec the TUI —
# official `grok` on PATH is the fallback. There is no GROK_SKIP_* / no
# GROK_DISABLE_AUTOUPDATER; the binary also refuses to start without
# GROK_FORK_SYNC_OK from a successful pass here.
#
# On every start (one pass, one rebuild max):
#   1. git fetch origin/main  (this GitHub fork)
#   2. git fetch upstream/main (xai-org/grok-build)
#   3. fast-forward onto origin/main; if histories were rewritten but local has no
#      unique commit subjects, reset to origin (take their extras)
#   4. rebase onto upstream/main, dropping later-reverted commit series
#   5. force-with-lease push of a successful rebase so other machines can FF
#   6. rebuild release binary only if rust sources changed (or binary missing)
#   7. install scripts/home-rules/*.md into $GROK_HOME/rules (global Grok rules)
#   8. exec the fork binary with all args
#
# Never changes the caller's working directory — git/cargo run under $REPO
# via git -C / subshells so Grok opens in the directory you launched from.
#
# Stock solid bg:     GROK_SOLID_BG=1 grok-fork ...

set -uo pipefail
# Note: not `set -e` — prefer launching over dying mid-sync.

# Default repo = parent of this script after resolving symlinks.
# A PATH shim that copies this file (instead of linking it) would resolve to
# the shim's directory; GROK_FORK_REPO overrides that.
_resolve_script_dir() {
  local src="${BASH_SOURCE[0]:-$0}"
  while [[ -L "$src" ]]; do
    local dir link
    dir="$(cd "$(dirname "$src")" && pwd)" || return 1
    link="$(readlink "$src")" || return 1
    if [[ "$link" == /* ]]; then
      src="$link"
    else
      src="$dir/$link"
    fi
  done
  cd "$(dirname "$src")" && pwd
}
_SCRIPT_DIR="$(_resolve_script_dir 2>/dev/null || true)"
if [[ -n "$_SCRIPT_DIR" && -d "$_SCRIPT_DIR/.." ]]; then
  _DEFAULT_REPO="$(cd "$_SCRIPT_DIR/.." && pwd)"
else
  _DEFAULT_REPO="${HOME}/projects/grok-build"
fi
REPO="${GROK_FORK_REPO:-$_DEFAULT_REPO}"
BRANCH="${GROK_FORK_BRANCH:-main}"
ORIGIN_REMOTE="${GROK_ORIGIN_REMOTE:-origin}"
ORIGIN_REF="${GROK_ORIGIN_REF:-$BRANCH}"
UPSTREAM_REMOTE="${GROK_UPSTREAM_REMOTE:-upstream}"
UPSTREAM_REF="${GROK_UPSTREAM_REF:-main}"
BIN="${GROK_FORK_BIN:-$REPO/target/release/xai-grok-pager}"
STAMP="${GROK_FORK_STAMP:-$REPO/.fork-built-at}"
LOCK_DIR="${GROK_FORK_LOCK:-$REPO/.fork-launch.lock}"
LOCK_WAIT_SECS="${GROK_FORK_LOCK_WAIT_SECS:-1800}"

# Directory the user launched from — restore before exec so agent CWD is correct.
START_CWD=$PWD

export PATH="${HOME}/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:${PATH}"
# /usr/bin/git is Xcode's. If the Xcode license isn't accepted, every git
# command exits 69 and `remote get-url origin` looks like "missing origin".
if [[ -d /Library/Developer/CommandLineTools ]]; then
  export DEVELOPER_DIR="${DEVELOPER_DIR:-/Library/Developer/CommandLineTools}"
fi
export GROK_PROCESS_BRAND="${GROK_PROCESS_BRAND:-fork}"
export GROK_MCP_CHANNELS="${GROK_MCP_CHANNELS:-1}"
export GROK_FORK=1
export GROK_FORK_REPO="$REPO"
export GROK_ORIGIN_REMOTE="$ORIGIN_REMOTE"
export GROK_ORIGIN_REF="$ORIGIN_REF"
export GROK_UPSTREAM_REMOTE="$UPSTREAM_REMOTE"
export GROK_UPSTREAM_REF="$UPSTREAM_REF"

log() { printf '[grok-fork] %s\n' "$*" >&2; }

die() {
  log "error: $*"
  log "fork refused to start. Official grok is still on PATH as the fallback."
  exit 1
}

g() { git -C "$REPO" "$@"; }

refuse_disabled_update_env() {
  if [[ "${GROK_SKIP_SYNC:-}" == "1" || "${GROK_SKIP_REBUILD:-}" == "1" || "${GROK_SKIP_PUSH:-}" == "1" ]]; then
    die "GROK_SKIP_SYNC / GROK_SKIP_REBUILD / GROK_SKIP_PUSH are not allowed — fork must take updates"
  fi
  case "${GROK_DISABLE_AUTOUPDATER:-}" in
    ''|0|false|off|no|FALSE|OFF|NO) ;;
    *) die "GROK_DISABLE_AUTOUPDATER is not allowed — fork must take updates" ;;
  esac
}

# Wait for another launch's sync/rebuild (cargo can take a while). Recover
# stale locks left behind when a previous launcher was killed. Die rather
# than skip the update if the lock is still held after LOCK_WAIT_SECS.
_lock_holder_alive() {
  local pid=""
  [[ -f "$LOCK_DIR/pid" ]] || return 1
  pid=$(cat "$LOCK_DIR/pid" 2>/dev/null || true)
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

_clear_lock() {
  rm -rf "$LOCK_DIR" 2>/dev/null || true
}

acquire_lock() {
  local waited=0
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    if ! _lock_holder_alive; then
      log "removing stale launch lock (no live holder)"
      _clear_lock
      continue
    fi
    if [[ $waited -eq 0 ]]; then
      local holder
      holder=$(cat "$LOCK_DIR/pid" 2>/dev/null || echo "?")
      log "waiting for another launch (pid $holder) to finish sync …"
    elif [[ $((waited % 5)) -eq 0 ]]; then
      log "still waiting for launch lock (${waited}s) …"
    fi
    if [[ $waited -ge $LOCK_WAIT_SECS ]]; then
      die "another launch is still syncing after ${LOCK_WAIT_SECS}s — not starting a stale fork"
    fi
    sleep 1
    waited=$((waited + 1))
  done
  # Record holder so other launches can detect live vs stale.
  printf '%s\n' "$$" >"$LOCK_DIR/pid" 2>/dev/null || true
  trap '_clear_lock' EXIT
  return 0
}

release_lock() {
  _clear_lock
  trap - EXIT
}

path_requires_rust_rebuild() {
  local n="${1//\\//}"
  case "$n" in
    scripts/*|.github/*) return 1 ;;
    *.md|*.txt) return 1 ;;
    LICENSE|SOURCE_REV|.gitignore|.gitattributes) return 1 ;;
  esac
  return 0
}

need_rebuild() {
  [[ ! -x "$BIN" ]] && return 0
  [[ ! -f "$STAMP" ]] && return 0
  local head built
  head=$(g rev-parse HEAD 2>/dev/null) || return 0
  built=$(cat "$STAMP" 2>/dev/null || true)
  [[ -n "$built" ]] || return 0
  [[ "$head" == "$built" ]] && return 1
  g cat-file -e "${built}^{commit}" 2>/dev/null || return 0
  local f
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    if path_requires_rust_rebuild "$f"; then
      return 0
    fi
  done < <(g diff --name-only "$built" HEAD 2>/dev/null)
  return 1
}

# Tracked-only dirtiness (never untracked — target/ can be multi-GB).
tracked_dirty() {
  [[ -n $(g status --porcelain -uno 2>/dev/null) ]]
}

# Subjects on A..B that do not appear on B..A. Used to tell "rewritten same
# stack" (empty) from "local has unique work" (keep local).
unique_subjects() {
  local left="$1" right="$2"
  comm -23 \
    <(g log --format=%s "$left" 2>/dev/null | sed '/^$/d' | sort -u) \
    <(g log --format=%s "$right" 2>/dev/null | sed '/^$/d' | sort -u)
}

# Fast-forward local BRANCH onto origin/ORIGIN_REF when we are strictly behind.
# Diverged rewrites with no unique local subjects reset to origin.
# Does not push here (push happens after a successful upstream rebase).
integrate_origin() {
  if ! g remote get-url "$ORIGIN_REMOTE" &>/dev/null; then
    die "cannot read remote '$ORIGIN_REMOTE' ($(g remote get-url "$ORIGIN_REMOTE" 2>&1 | tr '\n' ' '))"
  fi

  local origin_tip
  if ! origin_tip=$(g rev-parse "$ORIGIN_REMOTE/$ORIGIN_REF" 2>/dev/null); then
    die "missing $ORIGIN_REMOTE/$ORIGIN_REF after fetch — cannot pull fork"
  fi

  local head base origin_short behind
  head=$(g rev-parse HEAD 2>/dev/null) || die "could not read HEAD"
  origin_short=$(g rev-parse --short "$ORIGIN_REMOTE/$ORIGIN_REF" 2>/dev/null || echo "")

  if [[ "$head" == "$origin_tip" ]]; then
    log "already up to date with $ORIGIN_REMOTE/$ORIGIN_REF ($origin_short)"
    return 0
  fi

  base=$(g merge-base HEAD "$ORIGIN_REMOTE/$ORIGIN_REF" 2>/dev/null) || die "could not find merge-base with origin"

  if [[ "$base" == "$head" ]]; then
    # origin is ahead of us — fast-forward only.
    behind=$(g rev-list --count HEAD.."$ORIGIN_REMOTE/$ORIGIN_REF" 2>/dev/null || echo "?")
    log "origin is $behind commit(s) ahead — fast-forwarding $BRANCH to $ORIGIN_REMOTE/$ORIGIN_REF"
    if g merge --ff-only "$ORIGIN_REMOTE/$ORIGIN_REF" >/dev/null 2>&1; then
      log "fast-forward complete ($(g rev-parse --short HEAD 2>/dev/null || echo '?'))"
      return 0
    fi
    die "could not fast-forward onto $ORIGIN_REMOTE/$ORIGIN_REF"
  fi

  if [[ "$base" == "$origin_tip" ]]; then
    # We are ahead of origin (local-only commits). Leave alone; do not push.
    local ahead
    ahead=$(g rev-list --count "$ORIGIN_REMOTE/$ORIGIN_REF"..HEAD 2>/dev/null || echo "?")
    log "local is $ahead commit(s) ahead of $ORIGIN_REMOTE/$ORIGIN_REF (not pushed; ok)"
    return 0
  fi

  # Diverged. Identical commit subjects ⇒ rewritten stack; take origin if
  # local added nothing of its own (origin may have extra launcher fixes).
  behind=$(g rev-list --count HEAD.."$ORIGIN_REMOTE/$ORIGIN_REF" 2>/dev/null || echo "?")
  local uniq
  uniq=$(unique_subjects "$ORIGIN_REMOTE/$ORIGIN_REF"..HEAD HEAD.."$ORIGIN_REMOTE/$ORIGIN_REF") || uniq="?"
  if [[ -z "$uniq" ]]; then
    log "origin is a rewrite with no unique local commits — resetting $BRANCH to $ORIGIN_REMOTE/$ORIGIN_REF"
    if g reset --hard "$ORIGIN_REMOTE/$ORIGIN_REF" >/dev/null 2>&1; then
      log "reset complete ($(g rev-parse --short HEAD 2>/dev/null || echo '?'))"
      return 0
    fi
    die "could not reset onto rewritten $ORIGIN_REMOTE/$ORIGIN_REF"
  fi

  die "origin and local have diverged (+$behind on origin; unique local commits). Merge/rebase in $REPO, then relaunch"
}

push_rebased_origin() {
  if ! g remote get-url "$ORIGIN_REMOTE" &>/dev/null; then
    die "cannot read remote '$ORIGIN_REMOTE' for push ($(g remote get-url "$ORIGIN_REMOTE" 2>&1 | tr '\n' ' '))"
  fi
  log "publishing rebased $BRANCH to $ORIGIN_REMOTE (force-with-lease)"
  if g push --force-with-lease -- "$ORIGIN_REMOTE" "HEAD:refs/heads/$ORIGIN_REF" >/dev/null 2>&1; then
    log "pushed $BRANCH → $ORIGIN_REMOTE/$ORIGIN_REF"
  else
    log "warning: could not push rebased $BRANCH — this machine is updated; other machines may stay diverged until you push"
  fi
}

# Rebase local BRANCH onto upstream when upstream moved.
# Drops feat+revert series via scripts/fork-drop-reverted-todo so a later-reverted
# experiment cannot stall every launch on an unrelated upstream conflict.
integrate_upstream() {
  if ! g remote get-url "$UPSTREAM_REMOTE" &>/dev/null; then
    die "cannot read remote '$UPSTREAM_REMOTE' ($(g remote get-url "$UPSTREAM_REMOTE" 2>&1 | tr '\n' ' '))"
  fi

  local head up base behind up_short head_before
  head=$(g rev-parse HEAD 2>/dev/null) || die "could not read HEAD"
  up=$(g rev-parse "$UPSTREAM_REMOTE/$UPSTREAM_REF" 2>/dev/null) || die "missing $UPSTREAM_REMOTE/$UPSTREAM_REF after fetch"
  base=$(g merge-base HEAD "$UPSTREAM_REMOTE/$UPSTREAM_REF" 2>/dev/null) || die "could not find merge-base with upstream"
  up_short=$(g rev-parse --short "$UPSTREAM_REMOTE/$UPSTREAM_REF" 2>/dev/null || echo "")

  if [[ "$base" == "$up" ]]; then
    log "already up to date with $UPSTREAM_REMOTE/$UPSTREAM_REF ($(g rev-parse --short "$UPSTREAM_REMOTE/$UPSTREAM_REF" 2>/dev/null || echo '?')); local $(g rev-parse --short HEAD 2>/dev/null || echo '?')"
    return 0
  fi

  behind=$(g rev-list --count HEAD.."$UPSTREAM_REMOTE/$UPSTREAM_REF" 2>/dev/null || echo "0")
  log "upstream is $behind commit(s) ahead — rebasing $BRANCH onto $UPSTREAM_REMOTE/$UPSTREAM_REF"
  head_before=$head

  local todo_editor="$REPO/scripts/fork-drop-reverted-todo"
  local rebase_ok=0
  if [[ -x "$todo_editor" ]]; then
    # GIT_SEQUENCE_EDITOR is honored; `git -c sequence.editor=` is not on Apple Git.
    if GIT_EDITOR=true GIT_SEQUENCE_EDITOR="$todo_editor" \
      g rebase --empty=drop -i "$UPSTREAM_REMOTE/$UPSTREAM_REF"; then
      rebase_ok=1
    fi
  elif g rebase --empty=drop "$UPSTREAM_REMOTE/$UPSTREAM_REF"; then
    rebase_ok=1
  fi

  if [[ $rebase_ok -eq 0 ]]; then
    local conflicts
    conflicts=$(g diff --name-only --diff-filter=U 2>/dev/null | tr '\n' ' ')
    log "rebase hit conflicts${conflicts:+ ($conflicts)} — aborting"
    g rebase --abort 2>/dev/null || true
    die "upstream rebase failed (+${behind} at $up_short). Fix conflicts in $REPO, then relaunch. Official grok is the fallback."
  fi
  log "rebase complete ($(g rev-parse --short HEAD 2>/dev/null || echo '?'))"
  if [[ "$(g rev-parse HEAD 2>/dev/null || true)" != "$head_before" ]]; then
    push_rebased_origin
  fi
  return 0
}

# Single sync pass: fetch both remotes, apply origin then upstream. Fail closed.
sync_remotes() {
  if [[ ! -d "$REPO/.git" ]]; then
    die "repo missing ($REPO) — cannot sync"
  fi

  local branch
  branch=$(g rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
  if [[ -n "$branch" && "$branch" != "$BRANCH" ]]; then
    log "checking out $BRANCH (was on $branch)"
    if ! g checkout "$BRANCH" 2>/dev/null; then
      die "could not checkout $BRANCH — fix git state in $REPO, then relaunch"
    fi
  fi

  # Only stash *tracked* changes. Never -u (untracked includes huge trees).
  local stashed=0
  if tracked_dirty; then
    log "stashing tracked local changes for sync (untracked left alone)"
    if g stash push -m "grok-fork-launch $(date -u +%Y-%m-%dT%H:%MZ)" >/dev/null 2>&1; then
      stashed=1
    else
      die "stash failed — local tracked changes blocked auto-sync. Commit/stash in $REPO, then relaunch"
    fi
  elif [[ -n $(g status --porcelain 2>/dev/null) ]]; then
    log "untracked files present (ignored for stash/sync)"
  fi

  log "fetching $ORIGIN_REMOTE/$ORIGIN_REF (fork) + $UPSTREAM_REMOTE/$UPSTREAM_REF …"
  # Explicit +refspec so a rewritten origin/main (force-with-lease after an
  # upstream rebase) actually moves the remote-tracking ref. `git fetch origin main`
  # only writes FETCH_HEAD and will miss fork-main updates.
  if ! g remote get-url "$ORIGIN_REMOTE" &>/dev/null; then
    die "cannot read remote '$ORIGIN_REMOTE' ($(g remote get-url "$ORIGIN_REMOTE" 2>&1 | tr '\n' ' '))"
  fi
  if ! g fetch --quiet --prune -- "$ORIGIN_REMOTE" \
    "+refs/heads/${ORIGIN_REF}:refs/remotes/${ORIGIN_REMOTE}/${ORIGIN_REF}" 2>/dev/null; then
    die "fetch $ORIGIN_REMOTE failed (offline?). Fork will not start stale."
  fi
  if ! g remote get-url "$UPSTREAM_REMOTE" &>/dev/null; then
    die "missing remote '$UPSTREAM_REMOTE'"
  fi
  if ! g fetch --quiet --prune -- "$UPSTREAM_REMOTE" \
    "+refs/heads/${UPSTREAM_REF}:refs/remotes/${UPSTREAM_REMOTE}/${UPSTREAM_REF}" 2>/dev/null; then
    die "fetch $UPSTREAM_REMOTE failed (offline?). Fork will not start stale."
  fi

  integrate_origin
  integrate_upstream

  if [[ $stashed -eq 1 ]]; then
    if g stash pop >/dev/null 2>&1; then
      log "restored stashed changes"
    else
      die "stash pop had conflicts — check git status in $REPO"
    fi
  fi
}

rebuild_if_needed() {
  if ! need_rebuild; then
    local head built
    head=$(g rev-parse HEAD 2>/dev/null || true)
    built=$(cat "$STAMP" 2>/dev/null || true)
    if [[ -n "$head" && "$head" != "$built" ]]; then
      printf '%s\n' "$head" >"$STAMP" 2>/dev/null || true
      log "binary current (no rust changes since last build)"
    else
      log "binary current ($(g rev-parse --short HEAD 2>/dev/null || echo '?'))"
    fi
    return 0
  fi
  command -v cargo >/dev/null 2>&1 || die "cargo missing — cannot rebuild fork"
  if ! command -v dotslash >/dev/null 2>&1; then
    log "warning: dotslash not found; build may need protoc on PATH"
  fi
  log "building release binary once (rust inputs changed or binary missing) …"
  if (
    cd "$REPO" || exit 1
    cargo build -p xai-grok-pager-bin --release
  ); then
    g rev-parse HEAD >"$STAMP" 2>/dev/null || true
    log "build ok → $BIN"
    return 0
  fi
  die "release build failed — not starting a stale fork"
}

# Copy fork-managed markdown into $GROK_HOME/rules so every Grok session (fork
# and official) loads it. Source of truth is $REPO/scripts/home-rules/.
install_home_rules() {
  local src="$REPO/scripts/home-rules"
  local dest="${GROK_HOME:-$HOME/.grok}/rules"
  [[ -d "$src" ]] || return 0
  mkdir -p "$dest" 2>/dev/null || {
    log "warning: could not create $dest — skipping home-rules install"
    return 0
  }
  local f base
  for f in "$src"/*.md; do
    [[ -f "$f" ]] || continue
    base=$(basename "$f")
    if cmp -s "$f" "$dest/$base" 2>/dev/null; then
      continue
    fi
    if cp "$f" "$dest/$base" 2>/dev/null; then
      log "installed home rule $base"
    else
      log "warning: could not install home rule $base"
    fi
  done
}

launch() {
  if [[ ! -x "$BIN" ]]; then
    die "no fork binary at $BIN — build with: cargo build -p xai-grok-pager-bin --release"
  fi
  cd "$START_CWD" 2>/dev/null || true
  export GROK_FORK_SYNC_OK=1
  exec "$BIN" "$@"
}

main() {
  log "launching from $REPO"
  refuse_disabled_update_env

  if [[ ! -d "$REPO/.git" ]]; then
    die "not a git repo at $REPO — cannot sync"
  fi

  acquire_lock || die "could not acquire launch lock"
  sync_remotes
  rebuild_if_needed
  release_lock

  install_home_rules
  log "exec $BIN"
  launch "$@"
}

main "$@"
